# Flask
FLASK_ENV=production
SECRET_KEY=change-this-to-a-long-random-secret-key

# Database (MySQL)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL=mysql+pymysql://placement_user:placement_pass@localhost:3306/campus_placement

# Default admin account created on first run / seed
ADMIN_EMAIL=admin@campus.edu
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Placement Officer

# App
PORT=5000
